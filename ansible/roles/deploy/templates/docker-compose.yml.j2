version: '3.9'
name: photition

services:
  postgres:
    image: postgres:{{ postgres_version|default('17-alpine') }}
    container_name: photition_db
    restart: unless-stopped
    environment:
      POSTGRES_DB: "{{ docker_env.DB_NAME }}"
      POSTGRES_USER: "{{ docker_env.DB_USER }}"

      POSTGRES_PASSWORD: "{{ docker_env.DB_PASSWORD }}"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "{{ docker_env.DB_PORT|default(5432) }}:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ docker_env.DB_USER }}"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: photition_redis
    restart: unless-stopped
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 5

  web:
    platform: linux/arm64
    build:
      context: .
      dockerfile: Dockerfile
    container_name: photition_web
    restart: unless-stopped
    command: daphne -b 0.0.0.0 -p 8000 photition.asgi:application
    env_file:
      - "{{ shared_dir }}/config/.env"
    ports:
      - "{{ docker_env.WEB_PORT|default(8000) }}:8000"
    volumes:
      - "{{ shared_dir }}/static:/app/static"
      - "{{ shared_dir }}/media:/app/media"
      - "{{ shared_dir }}/logs:/app/logs"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  worker:
    platform: linux/arm64
    build: .
    container_name: photition_worker
    restart: unless-stopped
    command: celery -A photition worker --loglevel=info
    env_file:
      - "{{ shared_dir }}/config/.env"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  beat:
    platform: linux/arm64
    build: .
    container_name: photition_beat
    restart: unless-stopped
    command: celery -A photition beat --loglevel=info
    env_file:
      - "{{ shared_dir }}/config/.env"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

volumes:
  postgres_data:
  redis_data: