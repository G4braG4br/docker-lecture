# База данных
DB_NAME={{ docker_env.DB_NAME }}
DB_USER={{ docker_env.DB_USER }}
DB_PASSWORD={{ docker_env.DB_PASSWORD }}
DB_HOST=postgres
DB_PORT=5432
DB_SSL_MODE=disable
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
PYTHON_JIT=0

GOOGLE_CLIENT_ID=test
GOOGLE_CLIENT_SECRET=test
VK_CLIENT_ID=test
VK_CLIENT_SECRET=test

# Django Settings
SECRET_KEY={{ django_secret_key | default('super-secret-key-for-lecture') }}
DEBUG={{ django_debug | default('True') }}
ALLOWED_HOSTS={{ django_allowed_hosts | default('*') }}
IS_DEBUG={{ django_is_debug | default('True') }}

# Redis (для Celery)
REDIS_URL=redis://:{{ docker_env.REDIS_PASSWORD }}@redis:6379/0
REDIS_HOST={{ docker_env.REDIS_HOST }}
REDIS_PORT={{ docker_env.REDIS_PORT }}
REDIS_PASSWORD={{ docker_env.REDIS_PASSWORD }}